# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_social_scheduler?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_social_scheduler

# JWT Secret for Authentication
JWT_SECRET=your_jwt_super_secret_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Google Gemini API Configuration (Required for AI Caption & Hashtag Generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API Configuration (Optional / Legacy)
OPENAI_API_KEY=your_openai_api_key_here

# Social Media Integration (Zernio API)
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Media Upload Directory (Relative to server or absolute path)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
