# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS and OAuth redirects)
# In production, set to your deployed Vercel domain: https://<your-project>.vercel.app
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_social_scheduler?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_social_scheduler

# JWT Secret for Authentication (min 32 characters recommended)
JWT_SECRET=your_jwt_super_secret_change_in_production_min32chars
JWT_EXPIRES_IN=7d

# Google Gemini API Configuration (Required for AI Caption & Hashtag Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Configuration (Optional / Legacy)
OPENAI_API_KEY=your_openai_api_key_here

# Social Media Integration (Zernio API)
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_BASE_URL=https://zernio.com/api

# Media Upload Directory (Relative to server or absolute path)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
